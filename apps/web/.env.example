# Shared Express API. Keep API_URL server-only when an internal production URL is available.
API_URL="http://localhost:4001"
NEXT_PUBLIC_API_URL="/backend"
NEXT_PUBLIC_BLOG_URL="http://localhost:3001"

# Set to 1 to render the homepage from the local fixture instead of the API.
# Useful for front-end work with no database running. Never set in production.
NEXT_PUBLIC_USE_MOCK=""
