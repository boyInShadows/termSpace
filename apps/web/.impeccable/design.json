    {
      "name": "Header Nav",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Plasma hover with a growing plasma-sweep underline; current route keeps it.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Explore</a><a href=\"#\">Communities</a><a href=\"#\">Creators</a></nav>",
      "css": ".ds-nav{display:flex;gap:32px;font:400 0.875rem/1.25rem var(--font-geist),sans-serif}.ds-nav a{position:relative;padding:4px 0;color:var(--foreground);text-decoration:none;transition:color 160ms}.ds-nav a::after{content:'';position:absolute;inset-inline:0;bottom:-2px;height:1px;background:linear-gradient(90deg,transparent,var(--primary),var(--spark),transparent);transform:scaleX(0);transform-origin:left;transition:transform 300ms}.ds-nav a:hover{color:var(--primary)}.ds-nav a:hover::after,.ds-nav a[aria-current]::after{transform:scaleX(1)}.ds-nav a[aria-current]{font-weight:600;color:var(--primary)}.ds-nav a:focus-visible{outline:2px solid var(--ring);outline-offset:3px;border-radius:2px}"
    },
