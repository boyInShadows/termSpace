      "css": ".ds-eyebrow{margin:0;font:600 0.75rem/1.1rem var(--font-geist-mono),monospace;letter-spacing:0.16em;text-transform:uppercase;color:var(--muted-foreground)}.ds-headline{margin:8px 0 0;font:500 2.6rem/0.98 var(--font-newsreader),Georgia,serif;letter-spacing:-0.03em;color:var(--foreground)}.ds-plasma{background:linear-gradient(102deg,var(--plasma-text-1) 0%,var(--plasma-text-2) 52%,var(--plasma-text-3) 100%);-webkit-background-clip:text;background-clip:text;color:transparent}"
    }
