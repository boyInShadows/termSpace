      "css": ".ds-input{min-height:44px;width:100%;max-width:320px;padding:0 12px;border-radius:0.6rem;border:1px solid var(--input);background:var(--surface);color:var(--foreground);font:400 0.875rem/1.5rem var(--font-geist),sans-serif;transition:border-color 160ms,box-shadow 160ms}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:hover{border-color:var(--border-strong)}.ds-input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 2px color-mix(in oklab,var(--ring) 20%,transparent)}"
