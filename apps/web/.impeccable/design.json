      "css": ".ds-badges{display:flex;gap:8px;flex-wrap:wrap}.ds-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:0.35rem;border:1px solid var(--border);background:var(--muted);color:var(--foreground);font:600 11px/1 var(--font-geist),sans-serif}.ds-badge-primary{border-color:color-mix(in oklab,var(--primary) 20%,transparent);background:color-mix(in oklab,var(--primary) 10%,transparent);color:var(--primary)}.ds-badge-warning{border-color:color-mix(in oklab,var(--warning) 25%,transparent);background:color-mix(in oklab,var(--warning) 10%,transparent);color:var(--warning)}.ds-badge-success{border-color:color-mix(in oklab,var(--success) 25%,transparent);background:color-mix(in oklab,var(--success) 10%,transparent);color:var(--success)}"
    },
    {
      "name": "Listing Card",
      "kind": "card",
      "refersTo": "listing-card",
      "description": "Catalog card; lifts on hover, Plasma border on focus-within.",
      "html": "<article class=\"ds-card\"><span class=\"ds-card-badge\">Agent</span><h3 class=\"ds-card-title\"><a href=\"#\">Conversion Copywriter</a></h3><p class=\"ds-card-outcome\">Turns a product brief into landing-page copy you can ship.</p><div class=\"ds-card-foot\"><span>★ 4.8 · 1.2k uses</span><a class=\"ds-card-cta\" href=\"#\">View details ↗</a></div></article>",
      "css": ".ds-card{display:flex;flex-direction:column;max-width:340px;padding:20px;border-radius:0.9rem;border:1px solid var(--border);background:var(--surface);color:var(--foreground);transition:transform 200ms,border-color 200ms,box-shadow 200ms}.ds-card:hover{transform:translateY(-2px);border-color:var(--border-strong);box-shadow:var(--shadow-lift)}.ds-card:focus-within{border-color:var(--primary)}.ds-card-badge{align-self:flex-start;padding:4px 8px;border-radius:0.35rem;border:1px solid var(--border);background:var(--muted);font:600 11px/1 var(--font-geist),sans-serif}.ds-card-title{margin:16px 0 0;font:600 1.25rem/1.375 var(--font-newsreader),Georgia,serif;letter-spacing:-0.025em}.ds-card-title a{color:inherit;text-decoration:none}.ds-card:hover .ds-card-title a{color:var(--primary)}.ds-card-outcome{margin:8px 0 0;font:400 0.875rem/1.5rem var(--font-geist),sans-serif;color:var(--muted-foreground)}.ds-card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:20px;padding-top:16px;border-top:1px solid var(--border);font:400 11px/1 var(--font-geist),sans-serif;color:var(--muted-foreground)}.ds-card-cta{display:inline-flex;align-items:center;min-height:36px;padding:0 12px;border-radius:0.6rem;border:1px solid var(--border-strong);background:var(--surface);color:var(--foreground);font:600 0.75rem/1 var(--font-geist),sans-serif;text-decoration:none}.ds-card:hover .ds-card-cta{border-color:var(--primary);color:var(--primary)}"
    },
    {
      "name": "Trust Chip",
      "kind": "custom",
      "refersTo": "trust-chip",
      "description": "One trust claim, stated the same way on the hero and the detail header.",
      "html": "<div class=\"ds-trust\"><span class=\"ds-trust-icon\">✓</span><span><span class=\"ds-trust-label\">Verified creator</span><span class=\"ds-trust-sub\">Signed release</span></span></div>",
      "css": ".ds-trust{display:inline-flex;align-items:center;gap:8px;padding:8px 10px;border-radius:1.25rem;border:1px solid var(--border);background:color-mix(in oklab,var(--surface) 82%,transparent);backdrop-filter:blur(12px);box-shadow:var(--shadow-lift);color:var(--foreground)}.ds-trust-icon{display:grid;place-items:center;width:24px;height:24px;border-radius:0.6rem;background:color-mix(in oklab,var(--muted) 70%,transparent);color:var(--verified);font-size:12px}.ds-trust-label{display:block;font:600 11px/1.25 var(--font-geist),sans-serif}.ds-trust-sub{display:block;font:400 9px/1.25 var(--font-geist-mono),monospace;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted-foreground)}"
