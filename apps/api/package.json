{
  "name": "@termspace/api",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Express and Prisma API for TermSpace applications",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "marketplace:role": "tsx src/scripts/manageMarketplaceRole.ts",
    "publish:scheduled": "tsx src/jobs/publishScheduled.ts",
    "email:worker": "tsx src/jobs/sendTransactionalEmails.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage.enabled=false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.0",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "prisma": "6.12.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
