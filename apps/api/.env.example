# Backend environment variables
# Copy this file to .env and fill in real values.

# Port the Express API listens on
PORT=4001

# PostgreSQL connection string (Prisma format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://blog_user:blog_password@localhost:5433/blog_db?schema=public"

# Comma-separated list of allowed CORS origins for the TermSpace and blog frontends
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Initial administrator credentials used by `npm run seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"
# Set true only when intentionally resetting seeded taxonomy/article links and edition ordering.
SEED_RESET=false

# Session duration in hours (defaults to 24).
ADMIN_SESSION_HOURS=24
READER_SESSION_DAYS=30
# Set to `.your-domain.com` in production so www and blog subdomains share login.
# Leave unset for localhost development (browsers reject Domain=.localhost).
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# Optional comma-separated proxy setting; use 1 behind one trusted reverse proxy.
TRUST_PROXY=0

# Comma-separated HTTPS hosts accepted for article images.
IMAGE_HOSTS="images.unsplash.com,media.example.com"

# Media storage: `local` for development or `r2` for Cloudflare R2.
MEDIA_STORAGE="local"
MEDIA_PUBLIC_URL="http://localhost:4001/media"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="term-academy-media"
# For production, connect the bucket to the custom domain used by MEDIA_PUBLIC_URL
# and add that hostname to both IMAGE_HOSTS and frontend NEXT_PUBLIC_IMAGE_HOSTS.

# Optional: set to "production" to disable verbose error details
NODE_ENV=development
