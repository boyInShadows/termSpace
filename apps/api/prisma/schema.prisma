// Prisma schema for the blog platform
// PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Author
// ---------------------------------------------------------------------------
model Author {
  id        String    @id @default(cuid())
  name      String
  bio       String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  articles  Article[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// Category
// ---------------------------------------------------------------------------
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  articles    Article[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// Article
// ---------------------------------------------------------------------------
model Article {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String?
  content      String
  heroImage    String?
  published    Boolean   @default(false)
  publishedAt  DateTime?
  scheduledAt  DateTime?
  previewToken String?   @unique
  seriesOrder  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  seriesId        String?
  series          Series?                 @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  tags            ArticleTag[]
  revisions       ArticleRevision[]
  comments        Comment[]
  bookmarks       ReaderBookmark[]
  readingProgress ReaderReadingProgress[]
  editions        EditionArticle[]

  @@index([slug])
  @@index([published])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([seriesId, seriesOrder])
  @@index([scheduledAt])
  @@index([published, publishedAt])
}

model Tag {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  articles    ArticleTag[]

  @@index([name])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Series {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  articles    Article[]

  @@index([name])
}

model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  snapshot  Json
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model MediaAsset {
  id                  String    @id @default(cuid())
  key                 String    @unique
  url                 String
  altText             String
  mimeType            String
  size                Int
  width               Int?
  height              Int?
  deletionRequestedAt DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([createdAt])
  @@index([url])
  @@index([deletionRequestedAt, deletedAt])
}

model MarkdownResource {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  category    String
  fileName    String
  content     String
  size        Int
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([category])
}

model Edition {
  id            String           @id @default(cuid())
  number        Int              @unique
  title         String
  slug          String           @unique
  description   String
  editorialNote String?
  coverImage    String?
  accentColor   String           @default("#b45309")
  published     Boolean          @default(false)
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  articles      EditionArticle[]

  @@index([published, publishedAt])
}

model EditionArticle {
  editionId String
  articleId String
  position  Int
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([editionId, articleId])
  @@unique([editionId, position])
  @@index([articleId])
}

model Comment {
  id         String    @id @default(cuid())
  articleId  String
  name       String
  email      String
  body       String
  approved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  article    Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, approved, createdAt])
  @@index([approved, createdAt])
}

model SearchQuery {
  id           String   @id @default(cuid())
  query        String   @unique
  count        Int      @default(1)
  lastSearched DateTime @default(now())

  @@index([count, lastSearched])
}

// ---------------------------------------------------------------------------
// NewsletterSubscriber
// ---------------------------------------------------------------------------
model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  active       Boolean  @default(true)
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@index([subscribedAt])
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ReaderUser {
  id                     String                                 @id @default(cuid())
  email                  String                                 @unique
  passwordHash           String?
  googleSubject          String?                                @unique
  emailVerifiedAt        DateTime?
  createdAt              DateTime                               @default(now())
  updatedAt              DateTime                               @updatedAt
  sessions               ReaderSession[]
  bookmarks              ReaderBookmark[]
  progress               ReaderReadingProgress[]
  productFavorites       MarketplaceFavorite[]
  marketplaceOrders      MarketplaceOrder[]
  marketplaceRoleGrants  MarketplaceRoleGrant[]
  marketplaceRoleEvents  MarketplaceRoleEvent[]
  emailVerifications     ReaderEmailVerification[]
  marketplaceCreator     MarketplaceCreator?                @relation("OwnedCreator")
  listingLifecycleEvents MarketplaceListingLifecycleEvent[]
  communityRequests      MarketplaceCommunityPlacementRequest[]
  communityPlacementsRequested MarketplaceCommunityPlacement[]      @relation("CommunityPlacementRequester")
  communityPlacementsModerated MarketplaceCommunityPlacement[]      @relation("CommunityPlacementModerator")
  communityPlacementEvents     MarketplaceCommunityPlacementEvent[] @relation("CommunityPlacementEventActor")
  requestedSourceChecks  MarketplaceSourceCheckJob[]
}

enum TransactionalEmailStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  FAILED
  CANCELLED
}

model ReaderEmailVerification {
  id         String                    @id @default(cuid())
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                  @default(now())
  user       ReaderUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox     TransactionalEmailOutbox?

  @@index([userId, createdAt])
  @@index([expiresAt, consumedAt])
}

model TransactionalEmailOutbox {
  id             String                   @id @default(cuid())
  verificationId String                   @unique
  correlationId  String                   @unique
  status         TransactionalEmailStatus @default(PENDING)
  attempts       Int                      @default(0)
  nextAttemptAt  DateTime                 @default(now())
  lockedAt       DateTime?
  sentAt         DateTime?
  lastStatusCode Int?
  lastErrorCode  String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  verification   ReaderEmailVerification  @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
}

model ReaderSession {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  expiresAt DateTime
  createdAt DateTime   @default(now())
  userId    String
  user      ReaderUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ReaderBookmark {
  userId    String
  articleId String
  createdAt DateTime   @default(now())
  user      ReaderUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, createdAt])
  @@index([articleId])
}

model ReaderReadingProgress {
  userId     String
  articleId  String
  percentage Int        @default(0)
  visitedAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       ReaderUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  article    Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([userId, visitedAt])
  @@index([articleId])
}

enum MarketplaceRole {
  CREATOR
  MODERATOR
  ADMINISTRATOR
}

enum MarketplaceRoleEventAction {
  GRANTED
  REVOKED
}

model MarketplaceRoleGrant {
  id        String          @id @default(cuid())
  userId    String
  role      MarketplaceRole
  grantedAt DateTime        @default(now())
  revokedAt DateTime?
  updatedAt DateTime        @updatedAt
  user      ReaderUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId, revokedAt])
  @@index([role, revokedAt])
}

model MarketplaceRoleEvent {
  id            String                     @id @default(cuid())
  subjectUserId String
  role          MarketplaceRole
  action        MarketplaceRoleEventAction
  actor         String
  reason        String
  correlationId String                     @unique
  createdAt     DateTime                   @default(now())
  subject       ReaderUser                 @relation(fields: [subjectUserId], references: [id], onDelete: Restrict)

  @@index([subjectUserId, createdAt])
  @@index([role, createdAt])
}

model MarketplaceCreator {
  id                  String                          @id @default(cuid())
  name                String
  handle              String                          @unique
  initials            String
  verified            Boolean                         @default(false)
  bio                 String
  followers           Int                             @default(0)
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  ownerUserId         String?                         @unique
  owner               ReaderUser?                     @relation("OwnedCreator", fields: [ownerUserId], references: [id], onDelete: Restrict)
  products            MarketplaceProduct[]
  providerConnections MarketplaceProviderConnection[]

  @@index([verified, followers])
}

model MarketplaceCategory {
  id       String               @id @default(cuid())
  name     String
  slug     String               @unique
  position Int                  @default(0)
  products MarketplaceProduct[]

  @@index([position, name])
}

model MarketplacePlatform {
  key                  String                            @id
  nameEn               String
  nameFa               String?
  position             Int                               @default(0)
  communities          MarketplaceCommunity[]
  productCompatibility MarketplaceProductCompatibility[]
  releaseCompatibility MarketplaceReleaseCompatibility[]

  @@index([position, nameEn])
}

enum MarketplaceCommunityState {
  ACTIVE
  ARCHIVED
}

model MarketplaceCommunity {
  id                   String                                 @id @default(cuid())
  slug                 String                                 @unique
  nameEn               String
  nameFa               String?
  descriptionEn        String
  descriptionFa        String?
  primaryPlatform      String
  platform             MarketplacePlatform                    @relation(fields: [primaryPlatform], references: [key], onDelete: Restrict)
  rulesEn              String
  rulesFa              String?
  submissionGuidanceEn String
  submissionGuidanceFa String?
  state                MarketplaceCommunityState              @default(ACTIVE)
  createdAt            DateTime                               @default(now())
  updatedAt            DateTime                               @updatedAt
  placementRequests    MarketplaceCommunityPlacementRequest[]
  placements           MarketplaceCommunityPlacement[]

  @@index([state, nameEn])
  @@index([primaryPlatform, state])
}

model MarketplaceProduct {
  id                       String                                 @id @default(cuid())
  slug                     String                                 @unique
  name                     String
  type                     String
  itemType                 MarketplaceItemType?
  classificationRequired   Boolean                                @default(false)
  lifecycleState           MarketplaceListingState                @default(DRAFT)
  lifecycleVersion         Int                                    @default(0)
  lifecycleResumeState     MarketplaceListingState?
  lifecycleResumePublished Boolean?
  approvedSnapshotId       String?                                @unique
  proposedSnapshotId       String?                                @unique
  outcome                  String
  description              String
  priceMinor               Int                                    @default(0)
  currency                 String                                 @default("USD")
  pricingModel             String                                 @default("free")
  platforms                String[]
  models                   String[]
  rating                   Decimal                                @default(0) @db.Decimal(2, 1)
  reviewCount              Int                                    @default(0)
  usageCount               Int                                    @default(0)
  purchaseCount            Int                                    @default(0)
  version                  String
  featured                 Boolean                                @default(false)
  trending                 Boolean                                @default(false)
  verified                 Boolean                                @default(false)
  tags                     String[]
  packageFileCount         Int?
  packageSizeBytes         Int?
  benefits                 String[]
  useCases                 Json?
  includedFiles            Json?
  exampleInput             String?
  exampleOutputTitle       String?
  exampleOutputBody        String?
  installationSteps        String[]
  previewFiles             String[]
  previewExcerpt           String?
  requirements             String?
  permissions              String?
  license                  String?
  updatesPolicy            String?
  refundPolicy             String?
  published                Boolean                                @default(false)
  createdAt                DateTime                               @default(now())
  updatedAt                DateTime                               @updatedAt
  creatorId                String
  creator                  MarketplaceCreator                     @relation(fields: [creatorId], references: [id])
  categoryId               String
  category                 MarketplaceCategory                    @relation(fields: [categoryId], references: [id])
  versions                 MarketplaceProductVersion[]
  reviews                  MarketplaceReview[]
  favorites                MarketplaceFavorite[]
  orders                   MarketplaceOrder[]
  manifestSnapshots        MarketplaceManifestSnapshot[]
  listingSnapshots         MarketplaceListingSnapshot[]           @relation("MarketplaceListingSnapshotHistory")
  approvedSnapshot         MarketplaceListingSnapshot?            @relation("MarketplaceApprovedListingSnapshot", fields: [approvedSnapshotId], references: [id], onDelete: Restrict)
  proposedSnapshot         MarketplaceListingSnapshot?            @relation("MarketplaceProposedListingSnapshot", fields: [proposedSnapshotId], references: [id], onDelete: Restrict)
  lifecycleEvents          MarketplaceListingLifecycleEvent[]
  communityRequests        MarketplaceCommunityPlacementRequest[]
  communityPlacements      MarketplaceCommunityPlacement[]
  compatibility            MarketplaceProductCompatibility[]

  @@index([published, featured, usageCount])
  @@index([published, type])
  @@index([published, itemType])
  @@index([classificationRequired])
  @@index([creatorId, lifecycleState, updatedAt])
  @@index([lifecycleState, updatedAt])
  @@index([published, categoryId])
  @@index([published, verified])
  @@index([updatedAt])
}

model MarketplaceProductCompatibility {
  productId   String
  platformKey String
  product     MarketplaceProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform    MarketplacePlatform @relation(fields: [platformKey], references: [key], onDelete: Restrict)

  @@id([productId, platformKey])
  @@index([platformKey, productId])
}

enum MarketplaceListingState {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum MarketplaceLifecycleActorType {
  SYSTEM
  CREATOR
  MODERATOR
  ADMINISTRATOR
}

enum MarketplaceListingLifecycleAction {
  DRAFT_SAVED
  INTERNAL_NOTE_ADDED
  SUBMITTED
  WITHDRAWN
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  SUSPENDED
  REINSTATED
  ARCHIVED
  RESTORED
}

model MarketplaceListingSnapshot {
  id                 String                                 @id @default(cuid())
  productId          String
  manifestSnapshotId String?
  releaseManifestId  String?
  revision           Int
  schemaVersion      Int                                    @default(1)
  digestSha256       String
  content            Json
  createdByActor     String
  createdAt          DateTime                               @default(now())
  product            MarketplaceProduct                     @relation("MarketplaceListingSnapshotHistory", fields: [productId], references: [id], onDelete: Restrict)
  manifestSnapshot   MarketplaceManifestSnapshot?           @relation(fields: [manifestSnapshotId], references: [id], onDelete: Restrict)
  releaseManifest    MarketplaceReleaseManifest?            @relation(fields: [releaseManifestId], references: [id], onDelete: Restrict)
  approvedFor        MarketplaceProduct?                    @relation("MarketplaceApprovedListingSnapshot")
  proposedFor        MarketplaceProduct?                    @relation("MarketplaceProposedListingSnapshot")
  lifecycleEvents    MarketplaceListingLifecycleEvent[]
  communityRequests  MarketplaceCommunityPlacementRequest[]
  communityPlacements MarketplaceCommunityPlacement[]
  communityPlacementEvents MarketplaceCommunityPlacementEvent[]

  @@unique([productId, revision])
  @@index([productId, createdAt])
  @@index([digestSha256])
  @@index([manifestSnapshotId])
  @@index([releaseManifestId])
}

model MarketplaceCommunityPlacementRequest {
  snapshotId        String
  communityId       String
  productId         String
  requestedByUserId String
  createdAt         DateTime                   @default(now())
  snapshot          MarketplaceListingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  community         MarketplaceCommunity       @relation(fields: [communityId], references: [id], onDelete: Restrict)
  product           MarketplaceProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestedBy       ReaderUser                 @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@id([snapshotId, communityId])
  @@index([productId, createdAt])
  @@index([communityId, createdAt])
  @@index([requestedByUserId, createdAt])
}

enum MarketplaceCommunityPlacementState {
  REQUESTED
  APPROVED
  REJECTED
  REMOVED
}

enum MarketplaceCommunityPlacementAction {
  APPROVED
  REJECTED
  REMOVED
}

model MarketplaceCommunityPlacement {
  id                  String                              @id @default(cuid())
  productId           String
  communityId         String
  state               MarketplaceCommunityPlacementState @default(REQUESTED)
  version             Int                                 @default(1)
  requestedSnapshotId String
  requestedByUserId   String
  requestedAt         DateTime                            @default(now())
  moderatedByUserId   String?
  decidedAt           DateTime?
  publicReason        String?
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt
  product             MarketplaceProduct                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  community           MarketplaceCommunity                @relation(fields: [communityId], references: [id], onDelete: Restrict)
  requestedSnapshot   MarketplaceListingSnapshot          @relation(fields: [requestedSnapshotId], references: [id], onDelete: Restrict)
  requestedBy         ReaderUser                          @relation("CommunityPlacementRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  moderatedBy         ReaderUser?                         @relation("CommunityPlacementModerator", fields: [moderatedByUserId], references: [id], onDelete: Restrict)
  events              MarketplaceCommunityPlacementEvent[]

  @@unique([productId, communityId])
  @@index([communityId, state, updatedAt])
  @@index([productId, state])
  @@index([requestedByUserId, requestedAt])
}

model MarketplaceCommunityPlacementEvent {
  id             String                              @id @default(cuid())
  placementId    String
  snapshotId     String
  previousState  MarketplaceCommunityPlacementState
  resultingState MarketplaceCommunityPlacementState
  action         MarketplaceCommunityPlacementAction
  actorType      MarketplaceLifecycleActorType
  actorUserId    String
  publicReason   String?
  internalNote   String?
  correlationId  String                              @unique
  createdAt      DateTime                            @default(now())
  placement      MarketplaceCommunityPlacement       @relation(fields: [placementId], references: [id], onDelete: Restrict)
  snapshot       MarketplaceListingSnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  actor          ReaderUser                          @relation("CommunityPlacementEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([placementId, createdAt])
  @@index([actorUserId, createdAt])
}

model MarketplaceListingLifecycleEvent {
  id             String                            @id @default(cuid())
  productId      String
  snapshotId     String?
  previousState  MarketplaceListingState?
  resultingState MarketplaceListingState
  action         MarketplaceListingLifecycleAction
  actorType      MarketplaceLifecycleActorType
  actorUserId    String?
  reasonCode     String
  publicReason   String?
  internalNote   String?
  correlationId  String                            @unique
  createdAt      DateTime                          @default(now())
  product        MarketplaceProduct                @relation(fields: [productId], references: [id], onDelete: Restrict)
  snapshot       MarketplaceListingSnapshot?       @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  actor          ReaderUser?                       @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resultingState, createdAt])
}

model MarketplaceProductVersion {
  id               String                       @id @default(cuid())
  productId        String
  version          String
  notes            String
  releasedAt       DateTime
  product          MarketplaceProduct           @relation(fields: [productId], references: [id], onDelete: Cascade)
  releaseManifests MarketplaceReleaseManifest[]

  @@unique([productId, version])
  @@index([productId, releasedAt])
}

enum MarketplaceItemType {
  SKILL
  AGENT
  MCP_SERVER
  INTEGRATION
  RULE
  PROMPT
  HOOK
  TEMPLATE
  WORKFLOW
}

enum MarketplaceSourceKind {
  GITHUB_REPOSITORY
  GITHUB_RELEASE
  NPM
}

enum MarketplaceProvider {
  GITHUB
  NPM
}

enum MarketplaceSourceCheckStatus {
  PENDING
  VERIFIED
  STALE
  RESTRICTED
  FAILED
}

enum MarketplaceSourceCheckOutcome {
  VERIFIED
  TRANSIENT_FAILURE
  RATE_LIMITED
  NOT_FOUND
  OWNERSHIP_LOST
  MISMATCH
  CONFIGURATION_ERROR
}

enum MarketplaceSourceCheckJobStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
  FAILED
  CANCELLED
}

enum MarketplaceInstallationMethod {
  MANUAL
  NPM
  GIT
  DOWNLOAD
  CONTAINER
  HOSTED
}

enum MarketplacePermissionCapability {
  FILESYSTEM_READ
  FILESYSTEM_WRITE
  PROCESS_EXECUTION
  NETWORK_ACCESS
  ENVIRONMENT_ACCESS
  SECRET_ACCESS
  BROWSER_AUTOMATION
  EXTERNAL_ACCOUNT_ACCESS
  PERSISTENT_STORAGE
  BACKGROUND_EXECUTION
  CODE_MODIFICATION
  TELEMETRY
}

model MarketplaceManifestSnapshot {
  id               String                       @id @default(cuid())
  productId        String
  manifestVersion  Int
  itemType         MarketplaceItemType
  digestSha256     String
  snapshot         Json
  createdAt        DateTime                     @default(now())
  product          MarketplaceProduct           @relation(fields: [productId], references: [id], onDelete: Restrict)
  listingSnapshots MarketplaceListingSnapshot[]

  @@index([productId, digestSha256])
  @@index([productId, createdAt])
}

model MarketplaceReleaseManifest {
  id                       String                                  @id @default(cuid())
  productVersionId         String
  revision                 Int
  manifestVersion          Int
  itemType                 MarketplaceItemType
  sourceKind               MarketplaceSourceKind
  sourceUrl                String
  sourceRef                String
  sourcePath               String?
  providerIntegrityDigest  String?
  artifactSizeBytes        Int?
  resolvedInstallationUrl  String?
  sourceResolvedAt         DateTime?
  ownershipVerifiedAt      DateTime?
  sourceCheckStatus        MarketplaceSourceCheckStatus            @default(PENDING)
  sourceCheckedAt          DateTime?
  sourceNextCheckAt        DateTime?
  sourceFailureCount       Int                                     @default(0)
  lastSourceErrorCode      String?
  verifiedConnectionId     String?
  installationMethod       MarketplaceInstallationMethod
  installationInstructions String[]
  runtimeRequirements      String[]
  accountRequirements      String[]
  operatingSystems         String[]
  dependencyRequirements   String[]
  licenseIdentifier        String?
  customLicenseUrl         String?
  documentationUrl         String?
  supportUrl               String?
  releaseNotes             String
  publishedAt              DateTime?
  createdAt                DateTime                                @default(now())
  productVersion           MarketplaceProductVersion               @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  compatibility            MarketplaceReleaseCompatibility[]
  permissions              MarketplaceReleasePermission[]
  environmentVariables     MarketplaceReleaseEnvironmentVariable[]
  skillDetails             MarketplaceSkillReleaseDetails?
  agentDetails             MarketplaceAgentReleaseDetails?
  mcpServerDetails         MarketplaceMcpServerReleaseDetails?
  integrationDetails       MarketplaceIntegrationReleaseDetails?
  ruleDetails              MarketplaceRuleReleaseDetails?
  promptDetails            MarketplacePromptReleaseDetails?
  hookDetails              MarketplaceHookReleaseDetails?
  templateDetails          MarketplaceTemplateReleaseDetails?
  workflowDetails          MarketplaceWorkflowReleaseDetails?
  listingSnapshots         MarketplaceListingSnapshot[]
  acquisitions             MarketplaceOrder[]
  verifiedConnection       MarketplaceProviderConnection?          @relation(fields: [verifiedConnectionId], references: [id], onDelete: Restrict)
  sourceChecks             MarketplaceSourceCheck[]
  sourceCheckJobs          MarketplaceSourceCheckJob[]

  @@unique([productVersionId, revision])
  @@index([itemType, publishedAt])
  @@index([sourceKind, sourceUrl])
  @@index([sourceCheckStatus, sourceNextCheckAt])
  @@index([verifiedConnectionId])
}

model MarketplaceProviderConnection {
  id                String                       @id @default(cuid())
  creatorId         String
  provider          MarketplaceProvider
  providerAccountId String
  accountLogin      String
  encryptedToken    String
  tokenIv           String
  tokenTag          String
  lastVerifiedAt    DateTime
  revokedAt         DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  creator           MarketplaceCreator           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  verifiedReleases  MarketplaceReleaseManifest[]
  sourceChecks      MarketplaceSourceCheck[]
  sourceCheckJobs   MarketplaceSourceCheckJob[]

  @@unique([creatorId, provider])
  @@index([provider, providerAccountId])
  @@index([creatorId, revokedAt])
}

model MarketplaceSourceCheck {
  id                      String                         @id @default(cuid())
  releaseManifestId       String
  connectionId            String?
  provider                MarketplaceProvider
  outcome                 MarketplaceSourceCheckOutcome
  providerStatusCode      Int?
  resolvedSourceRef       String?
  resolvedInstallationUrl String?
  providerIntegrityDigest String?
  artifactSizeBytes       Int?
  ownershipVerified       Boolean                        @default(false)
  errorCode               String?
  correlationId           String                         @unique
  latencyMs               Int
  createdAt               DateTime                       @default(now())
  releaseManifest         MarketplaceReleaseManifest     @relation(fields: [releaseManifestId], references: [id], onDelete: Restrict)
  connection              MarketplaceProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([releaseManifestId, createdAt])
  @@index([provider, outcome, createdAt])
}

model MarketplaceSourceCheckJob {
  id                String                          @id @default(cuid())
  releaseManifestId String
  connectionId      String
  requestedByUserId String?
  status            MarketplaceSourceCheckJobStatus @default(PENDING)
  attempts          Int                             @default(0)
  nextAttemptAt     DateTime                        @default(now())
  lockedAt          DateTime?
  correlationId     String                          @unique
  lastErrorCode     String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  releaseManifest   MarketplaceReleaseManifest      @relation(fields: [releaseManifestId], references: [id], onDelete: Restrict)
  connection        MarketplaceProviderConnection   @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  requestedBy       ReaderUser?                     @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([releaseManifestId, createdAt])
  @@index([lockedAt])
}

model MarketplaceReleaseCompatibility {
  id                String                     @id @default(cuid())
  releaseManifestId String
  platformKey       String
  models            String[]
  notes             String?
  releaseManifest   MarketplaceReleaseManifest @relation(fields: [releaseManifestId], references: [id], onDelete: Cascade)
  platform          MarketplacePlatform        @relation(fields: [platformKey], references: [key], onDelete: Restrict)

  @@unique([releaseManifestId, platformKey])
}

model MarketplaceReleasePermission {
  id                String                          @id @default(cuid())
  releaseManifestId String
  capability        MarketplacePermissionCapability
  required          Boolean                         @default(true)
  scope             String?
  destinations      String[]
  purpose           String
  releaseManifest   MarketplaceReleaseManifest      @relation(fields: [releaseManifestId], references: [id], onDelete: Cascade)

  @@unique([releaseManifestId, capability])
}

model MarketplaceReleaseEnvironmentVariable {
  id                String                     @id @default(cuid())
  releaseManifestId String
  name              String
  purpose           String
  required          Boolean                    @default(true)
  sensitive         Boolean                    @default(false)
  releaseManifest   MarketplaceReleaseManifest @relation(fields: [releaseManifestId], references: [id], onDelete: Cascade)

  @@unique([releaseManifestId, name])
}

model MarketplaceSkillReleaseDetails {
  releaseManifestId  String                     @id
  format             String
  entryPath          String
  activation         String
  bundledExecutables Boolean
  inputs             String[]
  outputs            String[]
  releaseManifest    MarketplaceReleaseManifest @relation(fields: [releaseManifestId], references: [id], onDelete: Cascade)
}

