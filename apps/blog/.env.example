# Frontend environment variables
# Copy this file to .env and adjust as needed.

# Base URL of the Express backend API
API_URL="http://localhost:4001"

# Browser-visible base URL used by interactive client components
NEXT_PUBLIC_API_URL="/backend"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# Public site URL used for canonical metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
MARKETPLACE_PUBLIC_URL="http://localhost:3000"

# Comma-separated HTTPS image hosts accepted by the UI.
NEXT_PUBLIC_IMAGE_HOSTS="images.unsplash.com,media.example.com"
