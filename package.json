{
  "name": "termspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @termspace/web",
    "dev:blog": "npm run dev --workspace @termspace/blog",
    "dev:api": "npm run dev --workspace @termspace/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate --workspace @termspace/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @termspace/api",
    "prisma:deploy": "npm run prisma:deploy --workspace @termspace/api",
    "seed": "npm run seed --workspace @termspace/api"
  },
  "engines": {
    "node": ">=22"
  }
}
