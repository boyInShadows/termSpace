# Docker Compose settings. Replace every default before production use.
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=blog_db
TRUST_PROXY=1

# Published host ports. Change these if an older local stack already uses them.
DB_HOST_PORT=5433
API_HOST_PORT=4001
WEB_HOST_PORT=3000
BLOG_HOST_PORT=3001

# Public frontend origins accepted by the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Reader sessions are intentionally host-only. Do not widen them to sibling subdomains.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
READER_SESSION_DAYS=30
GOOGLE_CLIENT_ID=
EMAIL_VERIFICATION_SECRET=replace-with-at-least-32-random-bytes
WEB_PUBLIC_URL=http://localhost:3000
# Local testing only. Refuses to activate unless WEB_PUBLIC_URL uses a loopback host.
LOCAL_AUTO_VERIFY_EMAIL=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM_ADDRESS=account@example.com
EMAIL_FROM_NAME=TermSpace
EMAIL_WORKER_BATCH_SIZE=10
# Generate with: openssl rand -base64 32
MARKETPLACE_PROVIDER_TOKEN_KEY=replace-with-a-base64-encoded-32-byte-key
MARKETPLACE_SOURCE_WORKER_BATCH_SIZE=10
MEDIA_STORAGE=local
MEDIA_PUBLIC_URL=http://localhost:4001/media
IMAGE_HOSTS=images.unsplash.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BLOG_SITE_URL=http://localhost:3001
