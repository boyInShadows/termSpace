FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/blog/package.json apps/blog/package.json
COPY apps/web/package.json apps/web/package.json

FROM base AS build
RUN npm ci --workspace @termspace/api --include-workspace-root=false
COPY apps/api apps/api
RUN npm run prisma:generate --workspace @termspace/api && npm run build --workspace @termspace/api

FROM build AS ops
ENV NODE_ENV=production
USER node
CMD ["npm", "run", "prisma:deploy", "--workspace", "@termspace/api"]

FROM base AS production-deps
# Install into a clean tree: workspace pruning can retain build-time peers.
RUN npm ci --omit=dev --workspace @termspace/api --include-workspace-root=false
# npm retains Prisma's devOptional code-generation peers from the workspace lock.
# The compiled JS/client engine needs neither compiler nor migration CLI.
RUN rm -rf /app/node_modules/typescript /app/apps/api/node_modules/typescript /app/node_modules/prisma /app/apps/api/node_modules/prisma
COPY --from=build /app/apps/api/node_modules/.prisma ./apps/api/node_modules/.prisma

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=production-deps /app/node_modules ./node_modules
COPY --from=production-deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY deploy/worker.mjs ./deploy/worker.mjs
RUN mkdir -p apps/api/uploads && chown -R node:node apps/api/uploads
WORKDIR /app/apps/api
USER node
EXPOSE 4001
CMD ["node", "dist/index.js"]
