# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS manifests
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/blog/package.json apps/blog/package.json
COPY apps/web/package.json apps/web/package.json

# Full install (TypeScript, build tooling) only to compile the site.
FROM manifests AS build
RUN --mount=type=cache,target=/root/.npm npm ci --workspace @termspace/web
COPY apps/web apps/web
ARG API_URL=http://localhost:4001
ARG NEXT_PUBLIC_BLOG_URL=http://localhost:3001
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ENV API_URL=$API_URL
ENV NEXT_PUBLIC_BLOG_URL=$NEXT_PUBLIC_BLOG_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
RUN npm run build --workspace @termspace/web

# Runtime dependencies only.
FROM manifests AS prod-deps
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --workspace @termspace/web

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --chown=node:node package.json package-lock.json ./
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/apps/web/package.json apps/web/package.json
COPY --from=build --chown=node:node /app/apps/web/next.config.ts apps/web/next.config.ts
COPY --from=build --chown=node:node /app/apps/web/.next apps/web/.next
COPY --from=build --chown=node:node /app/apps/web/public apps/web/public

EXPOSE 3000
USER node
CMD ["npm", "run", "start", "--workspace", "@termspace/web"]
