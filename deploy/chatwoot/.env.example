# Chatwoot environment for TermSpace. Copy to .env on the host (chmod 600).
# Never commit the real file.

SECRET_KEY_BASE=
# Active Record encryption keys (stable once set): openssl rand -hex 32
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

FRONTEND_URL=https://chat.termspace.dev
FORCE_SSL=false

ENABLE_ACCOUNT_SIGNUP=false
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=
REDIS_URL=redis://:change-me@redis:6379
REDIS_PASSWORD=

# No SMTP yet: no human agents and no transcript emails. Welcome messages are
# in-widget. Set SMTP_* later if conversation transcripts by email are wanted.
MAILER_SENDER_EMAIL=TermSpace <support@termspace.dev>

ACTIVE_STORAGE_SERVICE=local
VIPS_BLOCK_UNTRUSTED=1

# The Termbuddy bot is an internal compose service. Chatwoot's SSRF guard blocks
# private hostnames by default, so allow internal webhook targets. Only admins
# can configure webhook URLs on this installation.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

# Sidekiq is light on this box.
SIDEKIQ_CONCURRENCY=5

# Protect the public widget endpoints.
ENABLE_RACK_ATTACK=true
ENABLE_RACK_ATTACK_WIDGET_API=true
ENABLE_RACK_ATTACK_WIDGET_CONVERSATIONS=true
ENABLE_RACK_ATTACK_WIDGET_MESSAGES=true
RATE_LIMIT_WIDGET_CONVERSATIONS=20
RATE_LIMIT_WIDGET_MESSAGES=40
